# ==========================================================================
# ModbusGateway 采集进程配置
#   改这个文件就能换设备/换寄存器，不用改代码、不用重新编译。
#   命令行参数优先级高于本文件，例如：
#     ./collector.out --host 192.168.1.100 --port 502 --real
#   查看当前生效配置： ./collector.out --show-conf
# 格式： key = value    （# 开头是注释，行尾可以用 # 注释）
# ==========================================================================

# ---------------- 设备连接 ----------------
transport = tcp            # tcp（网口/网关） 或 rtu（RS485串口）
host      = 127.0.0.1      # 设备IP；接真实设备改成设备/网关的IP
port      = 5020           # 端口；标准 Modbus TCP 通常是 502，本机模拟器用 5020
slave     = 1              # 从机地址（设备手册里的 Slave ID / 站号）

# RTU（串口）设备才需要下面几项
serial    = /dev/ttyUSB0   # 串口设备节点（USB转485常见 ttyUSB0）
baud      = 9600           # 波特率
parity    = N              # 校验：N无 / E偶 / O奇
databits  = 8              # 数据位
stopbits  = 1              # 停止位

# ---------------- 寄存器映射 ----------------
# 按设备手册填，量纲不同就改 scale（原始值 ÷ scale = 真实值）
reg_temp   = 0             # 温度寄存器地址（保持寄存器 4xxxx，这里填偏移，如 40001→0）
reg_humi   = 1             # 湿度寄存器地址
scale_temp = 10            # 例：寄存器读到 265 → 265/10 = 26.5 ℃
scale_humi = 10            # 例：寄存器读到 674 → 674/10 = 67.4 %RH
# reg_count 一般不用填，程序会按上面两个地址自动算连续读几个（最多8个）

# ---------------- 采集参数 ----------------
interval_ms = 2000         # 采集周期（毫秒），也可网页上动态改（100~60000）
threshold   = 32.0         # 温度告警阈值（℃），超过则设备状态置为"故障"并记 WARN 日志

# ---------------- 数据来源标记（只影响界面/日志显示，不影响数据） ----------------
# 现在连的是本机 Modbus 模拟器（tools/modbus_slave.py），所以标记为模拟数据。
# 接上真实设备后，把 source_simulated 改成 0，并写上设备名，网页上就会显示"真实设备"。
source_name      = modbus-simulator
source_simulated = 1       # 1=模拟数据(测试用)   0=真实设备
